// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------
// Modelagem do Sistema de Alocação
// ---------------------------------

model User {
  id              String  @id @default(uuid())
  nome            String
  email           String  @unique
  senha           String
  role            String  @default("PROFESSOR") // PROFESSOR, ADMIN, COORDENADOR
  especializacao  String
  cargaHorariaMax Int
  preferencia     String?

  alocacoes Alocacao[]
}

model Disciplina {
  id                String @id @default(uuid())
  nome              String
  cargaHorariaTotal Int

  alocacoes Alocacao[]
}

model Turma {
  id        String @id @default(uuid())
  nome      String
  numAlunos Int
  periodo   Int
  turno     String

  alocacoes Alocacao[]
}

model Sala {
  id         String @id @default(uuid())
  nome       String
  predio     String
  capacidade Int
  tipo       String

  alocacoes Alocacao[]
}

model Horario {
  id            String   @id @default(uuid())
  diaSemana     String
  horarioInicio DateTime
  horarioFim    DateTime

  alocacoes Alocacao[]
}

model Alocacao {
  id            String   @id @default(uuid())
  id_user       String
  id_disciplina String
  id_turma      String
  id_sala       String
  id_horario    String
  created_at    DateTime @default(now())

  user       User       @relation(fields: [id_user], references: [id])
  disciplina Disciplina @relation(fields: [id_disciplina], references: [id])
  turma      Turma      @relation(fields: [id_turma], references: [id])
  sala       Sala       @relation(fields: [id_sala], references: [id])
  horario    Horario    @relation(fields: [id_horario], references: [id])
}
