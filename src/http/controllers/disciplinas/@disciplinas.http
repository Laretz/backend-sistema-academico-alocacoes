@baseURL = http://localhost:3333

### Testes de API - Disciplinas

# @name Login
POST {{baseURL}}/session
Content-Type: application/json

{
  "email": "admin@admin.com",
  "senha": "123456"
}

###

# Listar todas as disciplinas
# @name GetDisciplinas
GET {{baseURL}}/disciplinas
Content-Type: application/json

###

# @name GetDisciplinasComProgresso
GET {{baseURL}}/disciplinas/com-progresso?turmaId=4339c652-1394-415c-a653-0a90a96fa6dd
Content-Type: application/json
Authorization: Bearer {{Login.response.body.token}}

###

# @name GetDisciplinaById
GET {{baseURL}}/disciplinas/43357332-f437-4344-b8fc-3fcdeca85f81
Content-Type: application/json

###

# @name CreateDisciplina
POST {{baseURL}}/disciplinas
Content-Type: application/json

