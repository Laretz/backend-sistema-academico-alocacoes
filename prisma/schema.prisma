generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------
// Modelagem do Sistema de Alocação
// ---------------------------------

enum Role {
  PROFESSOR
  ADMIN
  COORDENADOR
}

enum TipoDeSala {
  Lab
  Sala
}

model User {
  id                 String     @id @default(uuid())
  nome               String
  email              String     @unique
  senha              String
  role               Role     @default(PROFESSOR)
  especializacao     String?
  cargaHorariaMax    Int?
  preferencia        String?

  alocacoes          Alocacao[]
}

model Disciplina {
  id           String     @id @default(uuid())
  nome             String
  carga_horaria_atual Int
  tipo_de_sala      TipoDeSala @default(Sala)

  alocacoes        Alocacao[]
}

model Turma {
  id           String     @id @default(uuid())
  nome      String
  numAlunos Int
  periodo   Int
  turno     String

  alocacoes Alocacao[]
}

model Sala {
  id           String     @id @default(uuid())
  nome       String
  predio     String
  capacidade Int
  tipo       String
  computadores Int         @default(0)

  alocacoes  Alocacao[]
}

model Horario {
  id           String     @id @default(uuid())
  codigo       String
  diaSemana    String
  horarioInicio DateTime   @db.Time
  horarioFim    DateTime   @db.Time

  alocacoes   Alocacao[]
}

model Alocacao {
  id           String     @id @default(uuid())
  id_user  String
  id_disciplina String
  id_turma      String
  id_sala       String
  id_horario    String
  created_at  DateTime   @default(now())

  user          User  @relation(fields: [id_user], references: [id])
  disciplina   Disciplina @relation(fields: [id_disciplina], references: [id])
  turma        Turma      @relation(fields: [id_turma], references: [id])
  sala         Sala       @relation(fields: [id_sala], references: [id])
  horario      Horario    @relation(fields: [id_horario], references: [id])
}